# Optional locally; required when the process cannot use a signed-in Copilot user.
COPILOT_GITHUB_TOKEN=

# Optional for low-volume development (falls back to DEMO_KEY). Required for
# production nutrition lookups: https://fdc.nal.usda.gov/api-key-signup
FDC_API_KEY=

# Optional locally. Point this at a persistent volume in a single-instance
# deployment.
RECIPE_DATABASE_PATH=

# Opt in only when intentionally running the real website + Copilot test.
RUN_LIVE_RECIPE_TESTS=0

# Opt in only when intentionally querying the real USDA API.
RUN_LIVE_NUTRITION_TESTS=0
